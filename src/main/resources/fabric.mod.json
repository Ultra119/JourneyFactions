{
  "schemaVersion": 1,
  "id": "journeyfactions",
  "version": "${version}",
  "name": "JourneyFactions",
  "description": "A companion mod that displays faction territories on JourneyMap. Works on both client and server.",
  "authors": [
    "Arona74",
    "Ultra119"
  ],
  "contact": {
    "homepage": "https://github.com/Ultra119/JourneyFactions",
    "sources": "https://github.com/Ultra119/JourneyFactions"
  },
  "license": "MIT",
  "icon": "assets/journeyfactions/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.arona74.journeyfactions.JourneyFactionsMain"
    ],
    "client": [
      "io.arona74.journeyfactions.JourneyFactions"
    ],
    "journeymap": [
      "io.arona74.journeyfactions.journeymap.JourneyMapPlugin"
    ],
